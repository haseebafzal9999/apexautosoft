# ============================================================
# ApexAutosoft — environment template
# Copy to .env.local and fill in real values. Never commit .env.local.
# ============================================================

# Where Contact Us form submissions are delivered (server-side only).
# Example: your gmail for testing, then Asim bhai's Gmail later.
CONTACT_RECEIVER_EMAIL=

# Sender shown on received emails. For testing, leave unset to use
# Resend's sandbox address (onbrd@resend.dev, works without domain
# verification). After verifying apexautosoft.com on Resend, set:
# EMAIL_FROM=info@apexautosoft.com
EMAIL_FROM=

# Resend API key (https://resend.com/api-keys). Never NEXT_PUBLIC_.
EMAIL_API_KEY=